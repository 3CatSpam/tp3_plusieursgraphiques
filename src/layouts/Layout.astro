---
import "../styles/global.css";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body>
    <header class="site-header">
      <label for="page-navigation">Page</label>
      <select id="page-navigation" aria-label="Navigation principale">
        <option value="/" selected={Astro.url.pathname === "/"}>Accueil</option>
        <option value="/tabs" selected={Astro.url.pathname === "/tabs"}>Onglets</option>
        <option value="/adelie" selected={Astro.url.pathname === "/adelie"}>Adelie</option>
        <option value="/chinstrap" selected={Astro.url.pathname === "/chinstrap"}>Chinstrap</option>
        <option value="/gentoo" selected={Astro.url.pathname === "/gentoo"}>Gentoo</option>
        <option value="/diamonds" selected={Astro.url.pathname === "/diamonds"}>Diamants</option>
        <option value="/cars" selected={Astro.url.pathname === "/cars"}>Voitures</option>
      </select>
    </header>
    <slot />
  </body>
</html>

<script>
  document.querySelector("#page-navigation")?.addEventListener("change", (event) => {
    const value = (event.target as HTMLSelectElement).value;
    location.pathname = value;
  });
</script>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  .site-header {
    border-bottom: 1px solid #d9e2e8;
    background: #ffffff;
    padding: 0.75rem 1.5rem;
  }

  .site-header {
    align-items: center;
    display: flex;
    gap: 0.75rem;
    max-width: 72rem;
    margin: 0 auto;
  }

  select {
    border: 1px solid #b8cbd2;
    border-radius: 0.375rem;
    color: #176b87;
    font: inherit;
    padding: 0.5rem 2rem 0.5rem 0.75rem;
  }
</style>
