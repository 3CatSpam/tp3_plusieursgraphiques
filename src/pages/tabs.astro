---
import { Tabs, TabsList, TabsTab, TabsPanel } from "accessible-astro-components";
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";

const AccessibleTabs = Tabs as any;
const AccessibleTabsList = TabsList as any;
const AccessibleTabsTab = TabsTab as any;
const AccessibleTabsPanel = TabsPanel as any;

const penguinsAdelie = penguins.filter(({ species }) => species === "Adelie");
const penguinsChinstrap = penguins.filter(({ species }) => species === "Chinstrap");
const penguinsGentoo = penguins.filter(({ species }) => species === "Gentoo");
---

<Layout>
  <main class="home-content">
    <h1 class="mt-0 text-2xl">Comparaison des manchots avec des onglets</h1>

    <AccessibleTabs class="!my-6">
      <AccessibleTabsList class="!flex !gap-4 !border-b !border-[#d9e2e8]">
        <AccessibleTabsTab
          id="adelie-tab"
          controls="adelie-panel"
          selected
          class="!rounded-t-md !border !border-b-0 !border-[#d9e2e8] !bg-white !px-4 !py-2 !font-bold !text-[#176b87] aria-selected:!bg-[#d9f0f5] aria-selected:!text-[#0f566b]"
        >
          Adelie
        </AccessibleTabsTab>
        <AccessibleTabsTab
          id="chinstrap-tab"
          controls="chinstrap-panel"
          class="!rounded-t-md !border !border-b-0 !border-[#d9e2e8] !bg-white !px-4 !py-2 !font-bold !text-[#176b87] aria-selected:!bg-[#d9f0f5] aria-selected:!text-[#0f566b]"
        >
          Chinstrap
        </AccessibleTabsTab>
        <AccessibleTabsTab
          id="gentoo-tab"
          controls="gentoo-panel"
          class="!rounded-t-md !border !border-b-0 !border-[#d9e2e8] !bg-white !px-4 !py-2 !font-bold !text-[#176b87] aria-selected:!bg-[#d9f0f5] aria-selected:!text-[#0f566b]"
        >
          Gentoo
        </AccessibleTabsTab>
      </AccessibleTabsList>

      <AccessibleTabsPanel
        id="adelie-panel"
        labelledby="adelie-tab"
        selected
        class="!rounded-b-lg !border !border-t-0 !border-[#d9e2e8] !bg-white !p-4"
      >
        <h2 class="mt-0">Adelie</h2>
        <PlotFigure
          title="Mesures des manchots Adelie"
          subtitle="Longueur et profondeur du culmen des manchots Adelie."
          caption="Figure 1. Distribution des mesures des manchots Adelie."
          ariaLabel="Nuage de points des mesures des manchots Adelie"
          options={{
            marks: [
              Plot.dot(penguinsAdelie, {
                x: "culmen_length_mm",
                y: "culmen_depth_mm",
                stroke: "species",
              }),
            ],
          }}
        />
      </AccessibleTabsPanel>

      <AccessibleTabsPanel
        id="chinstrap-panel"
        labelledby="chinstrap-tab"
        class="!rounded-b-lg !border !border-t-0 !border-[#d9e2e8] !bg-white !p-4"
      >
        <h2 class="mt-0">Chinstrap</h2>
        <PlotFigure
          title="Mesures des manchots Chinstrap"
          subtitle="Longueur et profondeur du culmen des manchots Chinstrap."
          caption="Figure 2. Distribution des mesures des manchots Chinstrap."
          ariaLabel="Nuage de points des mesures des manchots Chinstrap"
          options={{
            marks: [
              Plot.dot(penguinsChinstrap, {
                x: "culmen_length_mm",
                y: "culmen_depth_mm",
                stroke: "species",
              }),
            ],
          }}
        />
      </AccessibleTabsPanel>

      <AccessibleTabsPanel
        id="gentoo-panel"
        labelledby="gentoo-tab"
        class="!rounded-b-lg !border !border-t-0 !border-[#d9e2e8] !bg-white !p-4"
      >
        <h2 class="mt-0">Gentoo</h2>
        <PlotFigure
          title="Mesures des manchots Gentoo"
          subtitle="Longueur et profondeur du culmen des manchots Gentoo."
          caption="Figure 3. Distribution des mesures des manchots Gentoo."
          ariaLabel="Nuage de points des mesures des manchots Gentoo"
          options={{
            marks: [
              Plot.dot(penguinsGentoo, {
                x: "culmen_length_mm",
                y: "culmen_depth_mm",
                stroke: "species",
              }),
            ],
          }}
        />
      </AccessibleTabsPanel>
    </AccessibleTabs>
  </main>
</Layout>
